# Non-secret configuration for the mail-sending functions.
# Credentials live in Secret Manager (SMTP_USERNAME / SMTP_PASSWORD), never here:
# .env is baked into the deployed source bundle.

SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SES speaks STARTTLS on 587 and implicit TLS on 465. Mismatching these two
# values is what produced the "tls_validate_record_header: wrong version number"
# failures under the old firestore-send-email extension.
SMTP_PORT=587
SMTP_SECURE=false
MAIL_FROM=BR7 Bot <noreply@br7biz.org.il>

TEMPLATE_ALLOWLIST=crm,crm-open,direct-question
RECIPIENT_ALLOW_DOMAINS=br7.org.il,br7biz.org.il,hasadna.org.il
MAX_EXTERNAL_RECIPIENTS=2
MAX_RECIPIENTS=10

ORPHAN_SCAN_ENABLED=true
CLAIM_ENABLED=true
SEND_ENABLED=true
